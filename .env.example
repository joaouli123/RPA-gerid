# === Credenciais Google (necessárias só no run REAL; a suíte de testes usa mocks) ===
# Caminho para o JSON da Service Account com acesso de leitura ao Drive/Sheets.
# A pasta "Protocolo INSS" e a planilha "Protocolo" precisam estar COMPARTILHADAS
# com o e-mail da Service Account (algo como nome@projeto.iam.gserviceaccount.com).
RPA_GOOGLE_KEY_FILE=./secrets/service-account.json

# ID da pasta raiz "Protocolo INSS" no Google Drive (parte da URL da pasta).
RPA_PASTA_RAIZ_ID=

# ID da planilha "Protocolo" no Google Sheets (parte da URL da planilha).
RPA_SPREADSHEET_ID=

# Nomes das abas da planilha (padrão abaixo).
RPA_ABA_CLIENTES=Clientes
RPA_ABA_GRUPO_FAMILIAR=GrupoFamiliar

# Limite de tamanho por anexo, em MB.
# Confirmado pelo Gerid em 2026-07-20: 5 MB por arquivo.
RPA_LIMITE_ARQUIVO_MB=5

# === Dados fixos do escritório (entram em todo requerimento) ===
# Ficam aqui, e não no código, porque incluem CPF (dado pessoal) — o .env não é versionado.
RPA_TELEFONE_PADRAO=
RPA_PROCURADOR_NOME=
# Só os dígitos — CPF pode começar com zero, então é sempre texto, nunca número.
RPA_PROCURADOR_CPF=
RPA_PROCURADOR_OAB=
RPA_PROCURADOR_EMAIL=
