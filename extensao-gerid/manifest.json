{
  "manifest_version": 3,
  "name": "Gerid RPA Automator",
  "version": "1.7.17",
  "description": "Automatiza o preenchimento de requerimentos BPC/LOAS no Gerid.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://fabriciodouglas.net/*",
    "https://*.fabriciodouglas.net/*",
    "https://atendimento.inss.gov.br/*",
    "https://geridinss.dataprev.gov.br/*"
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fabriciodouglas.net/*",
        "https://*.fabriciodouglas.net/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atendimento.inss.gov.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
