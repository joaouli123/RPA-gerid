{
  "manifest_version": 3,
  "name": "Gerid RPA Automator",
  "version": "1.2.1",
  "description": "Automatiza o preenchimento de requerimentos BPC/LOAS no Gerid.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "*://*.sslip.io/*",
    "*://*.inss.gov.br/*",
    "https://geridinss.dataprev.gov.br/*"
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.inss.gov.br/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
