{
  "name": "rpa-gerid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RPA que protocola requerimentos de BPC/LOAS no Gerid (INSS/Dataprev) a partir de dados no Google Drive.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/dryRun.ts",
    "cli": "tsx src/index.ts",
    "modelo": "tsx scripts/gerarModeloPlanilha.ts",
    "auth:test": "tsx scripts/testarAuth.ts",
    "escrita:test": "tsx scripts/testarEscrita.ts",
    "restaurar": "tsx scripts/restaurarPlanilha.ts",
    "snapshot": "tsx scripts/snapshotPlanilha.ts",
    "restaurar:snapshot": "tsx scripts/restaurarSnapshot.ts",
    "senha:hash": "tsx scripts/gerarSenha.ts"
  },
  "dependencies": {
    "@googleapis/drive": "^8.14.0",
    "@googleapis/sheets": "^9.3.0",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.15.0",
    "next": "^15.1.0",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
